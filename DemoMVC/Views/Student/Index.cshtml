@model IEnumerable<DemoMVC.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<div class="w3-row">
    <div>
        <a asp-action="Create" class="w3-border w3-border-blue w3-btn w3-right">NEW VERSION</a>
    </div>
    <div class="w3-col l2">
        <form  asp-action="Index">
            <input type="text" name="KeySearch" class="w3-input w3-border w3-border-red"/>
            <input type="submit" value="SEARCH " class="w3-btn w3-border w3-round"/>
        </form>
    </div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FullName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.StudentId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.StudentId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.StudentId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
